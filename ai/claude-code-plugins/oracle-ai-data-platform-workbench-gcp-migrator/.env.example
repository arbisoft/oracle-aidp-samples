# Google Cloud (source, read-only).
GCP_PROJECT=
# Path to a read-only service account key, kept OUTSIDE this repository; or
# leave unset to use Application Default Credentials
# (gcloud auth application-default login).
GOOGLE_APPLICATION_CREDENTIALS=
# Only for `export --apply` (large tables, plan --export-over-gb): the key file of a
# separate export service account that may run BigQuery jobs and write to the staging
# bucket. The read-only key above is never used to write.
GCP_EXPORT_CREDENTIALS=

# Oracle AIDP (destination)
# Default OCI Object Storage namespace for gs:// → oci:// translation.
# Find yours with: oci os ns get
OCI_NAMESPACE=
# The OCI region `export` and `transfer` write to; unset, the ~/.oci/config profile's region.
OCI_REGION=

# publish and run (through the `aidp` CLI: pip install aidp-cli; it signs with
# your ~/.oci/config API key). The cluster must be one that
# `aidp cluster list <workspace-key>` returns; publish checks it.
AIDP_INSTANCE_ID=
AIDP_WORKSPACE_KEY=
AIDP_CLUSTER_KEY=
# Your folder under /Workspace and the front of your job names.
AIDP_PREFIX=
# ~/.oci/config profile; leave unset for DEFAULT.
OCI_CLI_PROFILE=
# api_key for a ~/.oci/config API key; aidp-cli defaults to security_token.
AIDP_AUTH=api_key
